include(GNUInstallDirs)
include(CMakePackageConfigHelpers)
foreach(_target IN LISTS _asn1_targets)
  if(_target MATCHES "^asn1_")
    string(REGEX REPLACE "^asn1_" "" _export_name "${_target}")
    set_target_properties(${_target} PROPERTIES EXPORT_NAME "${_export_name}")
    if(NOT _export_name STREQUAL "c_runtime")
      get_target_property(_type ${_target} TYPE)
      if(_type STREQUAL "INTERFACE_LIBRARY")
        target_compile_features(${_target} INTERFACE cxx_std_17)
      else()
        target_compile_features(${_target} PUBLIC cxx_std_17)
      endif()
    endif()
    install(TARGETS ${_target} EXPORT asn1ToolkitTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
  elseif(_target STREQUAL "asn1cxx")
    install(TARGETS asn1cxx RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
  endif()
endforeach()
install(DIRECTORY "${PROJECT_SOURCE_DIR}/include/asn1" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
install(EXPORT asn1ToolkitTargets NAMESPACE asn1:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/asn1Toolkit)
configure_package_config_file("${PROJECT_SOURCE_DIR}/cmake/asn1ToolkitConfig.cmake.in"
  "${PROJECT_BINARY_DIR}/asn1ToolkitConfig.cmake" INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/asn1Toolkit)
write_basic_package_version_file("${PROJECT_BINARY_DIR}/asn1ToolkitConfigVersion.cmake"
  VERSION ${PROJECT_VERSION} COMPATIBILITY SameMinorVersion)
install(FILES "${PROJECT_BINARY_DIR}/asn1ToolkitConfig.cmake" "${PROJECT_BINARY_DIR}/asn1ToolkitConfigVersion.cmake"
  "${PROJECT_SOURCE_DIR}/cmake/GenerateC.cmake"
  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/asn1Toolkit)
