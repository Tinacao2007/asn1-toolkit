@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@ASN1_BUILD_COMPILER@)
  find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/asn1ToolkitTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GenerateC.cmake")
foreach(_component IN LISTS asn1Toolkit_FIND_COMPONENTS)
  if(TARGET asn1::${_component})
    set(asn1Toolkit_${_component}_FOUND TRUE)
  else()
    set(asn1Toolkit_${_component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(asn1Toolkit)
