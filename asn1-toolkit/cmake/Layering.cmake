# Check actual target dependency graph at configure time, including transitive edges.
function(asn1_check_layer_graph)
  set(_compiler asn1_ast asn1_frontend asn1_ir asn1_constraints asn1_semantic asn1_codegen asn1cxx)
  set(_runtime asn1_runtime asn1_c_runtime asn1_ber asn1_der asn1_cer asn1_per asn1_oer asn1_coer asn1_xer asn1_cxer asn1_exer asn1_jer asn1_jeri)
  foreach(_origin IN LISTS _compiler _runtime)
    if(NOT TARGET ${_origin})
      continue()
    endif()
    if(_origin IN_LIST _compiler)
      set(_forbidden ${_runtime})
    else()
      set(_forbidden ${_compiler})
    endif()
    set(_queue ${_origin})
    set(_seen "")
    while(_queue)
      list(GET _queue 0 _current)
      list(REMOVE_AT _queue 0)
      if(_current IN_LIST _seen OR NOT TARGET ${_current})
        continue()
      endif()
      list(APPEND _seen ${_current})
      if(_current IN_LIST _forbidden)
        message(FATAL_ERROR "ASN.1 layer violation: ${_origin} transitively links ${_current}")
      endif()
      foreach(_property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(_links ${_current} ${_property})
        foreach(_link IN LISTS _links)
          # Extract target references from LINK_ONLY and other generator expressions too.
          string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_:.-]*" _refs "${_link}")
          foreach(_ref IN LISTS _refs)
            if(TARGET ${_ref})
              get_target_property(_alias ${_ref} ALIASED_TARGET)
              if(_alias)
                set(_ref ${_alias})
              endif()
              list(APPEND _queue ${_ref})
            endif()
          endforeach()
        endforeach()
      endforeach()
    endwhile()
  endforeach()
endfunction()
asn1_check_layer_graph()
